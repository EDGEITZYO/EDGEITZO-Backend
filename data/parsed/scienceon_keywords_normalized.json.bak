      ],
      "DOI": "https://doi.org/10.23005/ksmls.2018.3.2.59",
      "Pubyear": 2018,
      "Pubdate": "20181217",
      "JournalName": "한국해양생명과학회지 = Journal of marine life science",
      "Author": [
        "최희찬",
        "최윤석",

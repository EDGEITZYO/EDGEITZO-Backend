        {
          "cited_cn": "124891593_11",
          "title": "Inhibition of biochemical model reactionsfor inflammatory processes by plant extracts: a review on recent",
          "author": "Hippeli S, Elstner EF",
          "journal": "Free Radic Res",
          "doi": "http://dx.doi.org/10.1080/10715769900301361",
          "pubyear": 1999,

      ],
      "DOI": "https://doi.org/10.12791/ksbec.2022.31.4.311",
      "Pubyear": 2022,
      "Pubdate": "20221031",
      "JournalName": "생물환경조절학회지 = Journal of bio-environment control",
      "Author": [

        "anaerobic digestion",
        "hydrogen",
        "organic acid",
        "microbial community"
      ],
      "keyword2_raw": "Food Wastewater . Anaerobic digestion . Hydrogen . Organic acid . Microbial community",
      "ISSN": [
        "1738-3935",

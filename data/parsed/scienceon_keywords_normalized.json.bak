        "protein a",
        "agarose",
        "polyglycidyl methacrylate (pgma)",
        "immunoglobulin g (igg)",
        "dynamic binding capacity"
      ],
      "keyword2_raw": null,
      "ISSN": [
        "1000-8713",
        "1872-2059"
      ],
      "DOI": "https://doi.org/10.3724/sp.j.1123.2024.01018",
      "Pubyear": 2024,
      "Pubdate": "20240508",
      "JournalName": "色譜 = Chinese journal of chromatography",
      "Author": [
        "ZHOU, Linjuan",
        "WANG, Zhuo",
        "REN, Xingfa",
        "LIU, Deyun",
        "ZHANG, Lingyi",

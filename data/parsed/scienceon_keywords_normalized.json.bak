        "salmo salar",
        "water temperature",
        "biomarker gene",
        "ngs rnaseq",
        "rt-qpcr"
      ],
      "keyword2_raw": "Salmo salar . Water temperature . Biomarker gene . NGS RNAseq . RT-qPCR",
      "ISSN": [
        "2508-7134"
      ],
      "DOI": "https://doi.org/10.23005/ksmls.2018.3.2.51",
      "Pubyear": 2018,
      "Pubdate": "20181217",
      "JournalName": "한국해양생명과학회지 = Journal of marine life science",
      "Author": [
        "강한승",
        "송재희",
        "강희웅"
      ],
      "references": [],
      "similar": []

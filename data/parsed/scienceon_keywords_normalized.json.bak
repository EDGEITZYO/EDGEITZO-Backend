      ],
      "DOI": "https://doi.org/10.3760/cma.j.cn121090-20231108-00257",
      "Pubyear": 2024,
      "Pubdate": "202403",
      "JournalName": "中華血液學雜誌 = Chinese journal of hematology",
      "Author": [
        "Dong, Xifeng",
        "Li, Yalan",
        "Li, Nianbin",
        "Lin, Weinan",
        "Wang, Ting",
        "Wang, Huaquan",

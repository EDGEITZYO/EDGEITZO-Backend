      "Pubyear": 2024,
      "Pubdate": "20241028",
      "JournalName": "浙江大學學報. Journal of Zhejiang University. Medical sciences. 醫學版",
      "Author": [
        "ZHONGXiaohui",
        "LYUChengjie",

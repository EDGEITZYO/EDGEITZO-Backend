      "Pubyear": 2023,
      "Pubdate": "20230208",
      "JournalName": "色譜 = Chinese journal of chromatography",
      "Author": [
        "HUANG, Yongpeng",
        "TANG, Hui",
        "MENG, Xiangyan",
        "ZHONG, Hui",

        "1975-7557"
      ],
      "DOI": "https://doi.org/10.16972/apjbve.14.1.201902.151",
      "Pubyear": 2019,
      "Pubdate": "20190228",
      "JournalName": "벤처창업연구= Asia-Pacific journal of business and venturing",
      "Author": [
        "김주영",
        "하규수"
      ],
      "references": [],
      "similar": []

        "2799-6182"
      ],
      "DOI": "https://doi.org/10.33562/jn.2023.12.2.4",
      "Pubyear": 2023,
      "Pubdate": "20230930",
      "JournalName": "Journal of naturopathy",
      "Author": [
        "박성수"
      ],

APP_NAME=PaperGraph Agent API
APP_ENV=prod
APP_PORT=8000

# Redis — Docker 내부 네트워크 (컨테이너명 사용)
REDIS_HOST=edgeitzo-redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Neo4j — Docker 내부 네트워크
NEO4J_URI=bolt://edgeitzo-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ChromaDB — Docker 내부 네트워크
CHROMA_HOST=edgeitzo-chromadb
CHROMA_PORT=8000

# PostgreSQL
POSTGRES_USER=edgeitzo
POSTGRES_PASSWORD=your_pg_password
POSTGRES_DB=edgeitzo
DATABASE_URL=postgresql+asyncpg://edgeitzo:your_pg_password@edgeitzo-postgres:5432/edgeitzo

# ScienceON
SCIENCEON_BASE_URL=https://apigateway.kisti.re.kr/openapicall.do
SCIENCEON_CLIENT_ID=
SCIENCEON_TOKEN=
SCIENCEON_VERSION=1.0

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# KCI
KCI_API_KEY=

# OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# JWT
JWT_SECRET_KEY=your_jwt_secret_key

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_QUALITY=claude-sonnet-5
LLM_BUDGET_TOTAL_USD=30.0

# Frontend
FRONTEND_URL=https://your-frontend-domain.com

# Celery — 내부 네트워크 Redis 사용
CELERY_BROKER_URL=redis://:your_redis_password@edgeitzo-redis:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@edgeitzo-redis:6379/2
